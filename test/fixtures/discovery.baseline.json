{
  "devices": {
    "area": {
      "external_id": "ext:ebird:area:main-house",
      "should_poll": false,
      "params": ["EBIRD_HOUSE"],
      "features": [
        {
          "external_id": "ext:ebird:area:main-house:species",
          "category": "counter-sensor",
          "type": "integer",
          "min": 0,
          "max": 1000,
          "read_only": true,
          "has_feedback": false
        },
        {
          "external_id": "ext:ebird:area:main-house:notable",
          "category": "counter-sensor",
          "type": "integer",
          "min": 0,
          "max": 1000,
          "read_only": true,
          "has_feedback": false
        },
        {
          "external_id": "ext:ebird:area:main-house:last_notable",
          "category": "text",
          "type": "text",
          "min": 0,
          "max": 0,
          "read_only": true,
          "has_feedback": false
        }
      ]
    },
    "species": {
      "external_id": "ext:ebird:species:eurhoo",
      "should_poll": false,
      "params": ["EBIRD_SPECIES_CODE"],
      "features": [
        {
          "external_id": "ext:ebird:species:eurhoo:near",
          "category": "presence-sensor",
          "type": "binary",
          "min": 0,
          "max": 1,
          "read_only": true,
          "has_feedback": false
        },
        {
          "external_id": "ext:ebird:species:eurhoo:distance",
          "category": "distance-sensor",
          "type": "decimal",
          "unit": "km",
          "min": 0,
          "max": 100,
          "read_only": true,
          "has_feedback": false
        },
        {
          "external_id": "ext:ebird:species:eurhoo:days_ago",
          "category": "duration",
          "type": "integer",
          "unit": "days",
          "min": 0,
          "max": 30,
          "read_only": true,
          "has_feedback": false
        }
      ]
    }
  },
